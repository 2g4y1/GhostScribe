# Google Gemini API key (free): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model used for the protocol
GEMINI_MODEL=gemini-flash-latest

# Default recording mode: true = EU AI Act compliant (no sentiment analysis), false = with sentiment analysis
AI_ACT_MODE=true

# Interface language: en, de or any other file in ghostscribe/static/locales/ (empty = browser language)
UI_LANGUAGE=

# Local voice recognition (true/false) and its parallel processes for long recordings
# (empty = a quarter of the logical processors, at most half of them)
VOICE_RECOGNITION=false
VOICE_WORKERS=
