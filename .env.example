# Trage hier deinen Google Gemini API Key ein (aus https://aistudio.google.com/):
GEMINI_API_KEY=

# Modellname (z.B. gemini-flash-latest, gemini-3-flash-preview, gemini-3.1-pro-preview, gemini-2.5-flash)
GEMINI_MODEL=gemini-flash-latest

# Standard-Aufnahmemodus (true = EU AI Act konform / sachlich, false = mit Stimmungsanalyse)
AI_ACT_MODE=true
