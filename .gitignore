# Secrets
.env
.env.*
!.env.example

# Python virtual environment
.venv/
venv/

# Byte-compiled files, tool caches and build artifacts
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
*.egg-info/
build/

# Audio never belongs in the repository (meetings are personal data, test audio is third-party material)
*.mp3
*.wav
*.m4a
*.flac

# Private recordings, screenshots, chat context and meeting protocols
recordings/*
!recordings/.gitkeep
meetings/*
!meetings/.gitkeep

# Local voice recognition: downloaded models and voice profiles (biometric data)
models/
voices/

# Release builds (published as GitHub release assets, never committed)
dist/
*.zip

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
